<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows10.0.26100.0</TargetFrameworks>
    <Version>0.0.9-pre0</Version>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>WindowsDesktop</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PackageId>LostTech.VirtualDesktop</PackageId>
    <Authors>grabacr.net, Victor Nova</Authors>
    <Company>Lost Tech LLC, grabacr.net</Company>
    <Description>C# wrapper for IVirtualDesktopManager on Windows 10. You need to include the app manifest in your project so as to target Windows 10.</Description>
    <Copyright>© 2025 Lost Tech LLC; © 2015 Manato KAMEYA</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/losttech/VirtualDesktop</PackageProjectUrl>
    <RepositoryUrl>https://github.com/losttech/VirtualDesktop.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Windows Windows10 Desktop VirtualDesktop</PackageTags>
    <PackageReleaseNotes>All customized APIs are declared deprecated</PackageReleaseNotes>

    <!-- The following is recommended for public projects -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The following is recommended for public projects -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.0" />
  </ItemGroup>

</Project>
