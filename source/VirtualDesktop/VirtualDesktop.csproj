<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net10.0-windows10.0.26100.0</TargetFrameworks>
    <Version>0.1.0</Version>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>WindowsDesktop</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PackageId>LostTech.VirtualDesktop</PackageId>
    <Authors>grabacr.net, Victor Nova</Authors>
    <Company>Lost Tech LLC, grabacr.net</Company>
    <Description>Query a window's virtual desktop, observe desktop changes, and move your application's windows using the Windows shell.</Description>
    <Copyright>© 2025 Lost Tech LLC; © 2015 Manato KAMEYA</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/losttech/VirtualDesktop</PackageProjectUrl>
    <RepositoryUrl>https://github.com/losttech/VirtualDesktop.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Windows Windows10 Desktop VirtualDesktop</PackageTags>
    <PackageReleaseNotes>Uses the Windows SDK virtual desktop interface through CsWin32. Use IdFromHwnd in place of TryGetIdFromHwnd. Desktop queries can return null during Explorer restarts, and the Boolean IsCurrentVirtualDesktop helper returns false. CurrentChanged includes the first identified desktop.</PackageReleaseNotes>

    <!-- The following is recommended for public projects -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net462'">
    <!-- CsWin32 supplies this attribute for its generated overloads. -->
    <PolySharpExcludeGeneratedTypes>System.Runtime.CompilerServices.OverloadResolutionPriorityAttribute</PolySharpExcludeGeneratedTypes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.17.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- The following is recommended for public projects -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

</Project>
